#!/bin/bash

# BASH Addins - the library of custom functions and aliases for enhanced BASH scripting and Terminal usage.
# Started by Artto Aunap (https://github.com/arrrtto) in 2025 for personal use, but in 2025 decided to share with the GNU/Linux and FOSS community.

BA_VERSION="1.2"
BA_DESCRIPTION="Enhanced BASH scripting library"
BA_AUTHOR="Artto Aunap"
BA_LICENSE="MIT"
BA_INSTALLER_PATH="$(realpath "$0")"
BA_INSTALLERFILE="${BA_INSTALLER_PATH##*/}"


# ------------ SETUP FUNCTIONS ------------
# Core functions for setting up BASH Addins for local computer use.

function add_to_bashrc() {
# If the line "souce bash.addins" does not yet exist in .bashrc file, this function will add it.
if ! grep -q "bash.addins" ~/.bashrc; then
echo "source ~/bin/bash.addins" >> ~/.bashrc
echo "BASH Addins now added to .bashrc for automatic loading and usage in your Terminal."
fi
}


function install_dependencies() {
# Function to install all the software dependencies (works best on Debian/Ubuntu-based systems)
  if grep -qiE "debian|ubuntu" /etc/os-release; then
    clear
    echo "🔧 Installing the needed software that BASH Addins depends upon for best possible use..."
    echo

    local packages=(
      qrencode ffmpeg wget sane-utils imagemagick ghostscript xdotool curl csvkit
      wmctrl xclip x11-apps tesseract-ocr scrot gnome-screenshot jq python3-full
      python3-xlsxwriter python3-openpyxl python3-odf python3-pdfkit html2text
      docx2txt xlsx2csv mupdf unoconv libreoffice libreoffice-script-provider-python
      sox pdftk
    )

    local failed=()
    local already_installed=()
    local unavailable=()

    echo "Updating package lists..."
    if ! sudo apt update -qq; then
      echo "⚠️ Package-list update failed. Will use the existing package lists."
    fi
    echo

    for pkg in "${packages[@]}"; do
      # Check if already installed
      if dpkg -s "$pkg" &>/dev/null; then
        echo "✅ $pkg is already installed, skipping."
        already_installed+=("$pkg")
        continue
      fi

      # Do not ask apt to install a package that is absent from the enabled
      # repositories. This is a normal skip, not an installer failure.
      if [[ -z $(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2}') ]] ||
         [[ $(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2}') == "(none)" ]]; then
        echo "⏭️ $pkg is unavailable from the enabled repositories, skipping."
        unavailable+=("$pkg")
        continue
      fi

      # Try to install
      echo -n "📦 Installing $pkg... "
      if sudo apt install -y -qq "$pkg" >/dev/null 2>&1; then
        echo "✅"
      else
        echo "❌ (failed)"
        failed+=("$pkg")
      fi
    done

    echo
    echo "─────────────────────────────────────────────"
    if [[ ${#failed[@]} -gt 0 ]]; then
      echo "⚠️  The following packages could not be installed:"
      for pkg in "${failed[@]}"; do
        echo "   - $pkg"
      done
      echo
      echo "You may need to enable extra repositories or install these manually."
    elif [[ ${#unavailable[@]} -eq 0 ]]; then
      echo "All software packages installed successfully!"
    else
      echo "All available software packages installed successfully."
    fi

    echo
    if [[ ${#unavailable[@]} -gt 0 ]]; then
      echo "ℹ️  Skipped packages unavailable from the enabled repositories:"
      for pkg in "${unavailable[@]}"; do
        echo "   - $pkg"
      done
      echo
    fi
    if [[ ${#already_installed[@]} -gt 0 ]]; then
      echo "ℹ️  Already installed packages:"
      for pkg in "${already_installed[@]}"; do
        echo "   - $pkg"
      done
    fi
    echo "─────────────────────────────────────────────"

  else
    echo "❌ This is not a Debian-based distribution. Skipping automatic installation."
  fi
}



function append_module() {
# Function for adding the needed custom functions modules into the final bash.addins file.
local module_file="$1"
if [[ -f "$module_file" ]]; then
  echo "Appending module: $module_file..."
  cat "$module_file"  | sed -n '3,$p' >> "$OUTPUT_FILE" # Append the module content starting from the 3rd row to skip the shebang and subsequent empty line
  echo "" >> "$OUTPUT_FILE"  # Add a newline for separation
else
  echo "Module $module_file not found!"
fi
}


function ba_compile() {
# Function for creating the final bash.addins file by adding in the necessary contents from the module files.
OUTPUT_FILE="bash.addins"   # Define the output file name to be generated: bash.addins
echo "#!/bin/bash" > "$OUTPUT_FILE"  # Create the bash.addins file and add shebang as the first line
sed -n '1!{/^BA_VERSION=/q;p}' "$BA_INSTALLER_PATH" >> "$OUTPUT_FILE"  # Add the contents from installer file from the second line to BA_VERSION line into the bash.addins file
# Append the modules, starting with main, aliases and system, then add others dynamically
for module_file in modules/main.sh modules/aliases.sh modules/system.sh; do
  [[ -f "$module_file" ]] || { echo "Required module missing: $module_file"; return 1; }
done
append_module "modules/main.sh"
append_module "modules/aliases.sh"
append_module "modules/system.sh"
for module_file in modules/*.sh; do
  case "$module_file" in
    modules/main.sh|modules/aliases.sh|modules/system.sh) continue ;;
  esac
  append_module "$module_file"
done
chmod +x "$OUTPUT_FILE"  # Make bash.addins file executable
echo "$OUTPUT_FILE file generated to the current folder."
}


function ba_tobin() {
mkdir -p "$HOME/bin"  # Create the bin folder, if it does not exist, for putting the bash.addins file into it later on
mv "$OUTPUT_FILE" "$HOME/bin/" && echo "Moved the $OUTPUT_FILE to $HOME/bin/"
}


function ba_versioncheck() {
# Checks for a newer version of the BASH Addins library on GitHub.
echo "Checking GitHub for a newer version..."
BA_GITHUBVERSION=$(curl -fsSL "https://raw.githubusercontent.com/arrrtto/bash.addins/main/installer" | sed -nE 's/^BA_VERSION="([^"]+)".*/\1/p' | head -n 1)
if [[ -z "$BA_GITHUBVERSION" ]]; then
  echo "❌ Could not retrieve the current version from GitHub."
  return 1
fi
# Compare the versions as arithmetic values...
if [[ "$BA_VERSION" == "$BA_GITHUBVERSION" ]]; then
echo "You have the same version that is on GitHub."
elif [[ "$(printf '%s\n' "$BA_VERSION" "$BA_GITHUBVERSION" | sort -V | head -n 1)" == "$BA_VERSION" ]]; then
echo "Newer version of the BASH addins library ($BA_GITHUBVERSION) available on GitHub."
else
echo "Your local version ($BA_VERSION) is newer than the GitHub version ($BA_GITHUBVERSION)."
fi
}


function download_modules() {
local force_refresh="${1:-false}"
local temp_dir modulefile
local -a modulefiles

if [[ -d ./modules && "$force_refresh" != "true" ]]; then
  return 0
fi

echo "Downloading modules..."
temp_dir=$(mktemp -d) || return 1

# Use GitHub's API rather than scraping the rendered HTML page.
mapfile -t modulefiles < <(
  curl -fsSL "https://api.github.com/repos/arrrtto/bash.addins/contents/modules" |
    sed -nE 's/.*"name": "([^"]+\.sh)".*/\1/p'
)

if [[ ${#modulefiles[@]} -eq 0 ]]; then
  echo "❌ Could not obtain the module list from GitHub."
  rm -rf -- "$temp_dir"
  return 1
fi

for modulefile in "${modulefiles[@]}"; do
  if ! curl -fsSL "https://raw.githubusercontent.com/arrrtto/bash.addins/main/modules/$modulefile" -o "$temp_dir/$modulefile"; then
    echo "❌ Could not download module: $modulefile"
    rm -rf -- "$temp_dir"
    return 1
  fi
done

# Only alter the installed module set after every download succeeded.
mkdir -p ./modules || { rm -rf -- "$temp_dir"; return 1; }
cp "$temp_dir"/*.sh ./modules/ || { rm -rf -- "$temp_dir"; return 1; }
rm -rf -- "$temp_dir"
}


function ba_setup() {
install_dependencies
download_modules || return 1
ba_compile || return 1
ba_tobin || return 1
add_to_bashrc
source "$HOME/bin/bash.addins" || return 1
gradient_text "Setup complete! BASH Add-ins now in use. Enjoy!"
}


function ba_update() {
download_modules true || return 1
ba_compile || return 1
ba_tobin || return 1
source "$HOME/bin/bash.addins" || return 1
gradient_text "Update complete! Enjoy!"
}


function show_help() {
clear
echo BASH Addins installer, version ${BA_VERSION}
printf "\n"
printf "Usage:\n\n"
printf "\e[32m./%s help\e[0m      Shows this help message\n" "${BA_INSTALLERFILE}"
printf "\e[32m./%s version\e[0m   Shows current version\n" "${BA_INSTALLERFILE}"
printf "\e[32m./%s check\e[0m     Checks GitHub for a newer version\n" "${BA_INSTALLERFILE}"
printf "\e[32m./%s setup\e[0m     Installs software dependencies, creates the final bash.addins file, which includes all the functions from the modules combined, moves it to ~/bin folder\n" "${BA_INSTALLERFILE}"
printf "\e[32m./%s update\e[0m    Downloads the latest module files from GitHub and compiles the bash.addins file and moves it to ~/bin\n" "${BA_INSTALLERFILE}"
printf "\e[32m./%s compile\e[0m   Just compiles local module files into final bash.addins file and moves it to ~/bin\n" "${BA_INSTALLERFILE}"
printf "\n\n"
}


# ------------ PARAMETERS TO RUN THE LIBRARY FILE WITH ------------
if [[ "$1" == "help" ]] || [[ "$1" == "" ]]; then show_help; fi
if [[ "$1" == "version" ]]; then echo "BASH Addins version $BA_VERSION" && sleep 1; fi
if [[ "$1" == "check" ]]; then ba_versioncheck; fi
if [[ "$1" == "setup" ]]; then ba_setup; fi
if [[ "$1" == "update" ]]; then ba_update; fi
if [[ "$1" == "compile" ]]; then ba_compile; ba_tobin; fi
